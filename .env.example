APP_NAME=agent-scaffold4py
APP_VERSION=0.1.0
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

HTTP_SERVER_ENABLED=true
MCP_SERVER_ENABLED=true
A2A_SERVER_ENABLED=true
ACP_SERVER_ENABLED=true

NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_SERVICE_NAME=agent-scaffold4py
NACOS_ENABLED=true
NACOS_SERVICE_IP=127.0.0.1
NACOS_CLUSTER_NAME=DEFAULT
NACOS_WEIGHT=1.0
NACOS_EPHEMERAL=true
NACOS_TIMEOUT_SECONDS=2.0
NACOS_FAIL_FAST=false
NACOS_METADATA={}
NACOS_REGISTER_HTTP_ENABLED=true
NACOS_REGISTER_MCP_ENABLED=true
NACOS_REGISTER_A2A_ENABLED=true
NACOS_REGISTER_ACP_ENABLED=true
NACOS_HTTP_SERVICE_NAME=agent-scaffold4py
NACOS_MCP_SERVICE_NAME=agent-scaffold4py-mcp
NACOS_A2A_SERVICE_NAME=agent-scaffold4py-a2a
NACOS_ACP_SERVICE_NAME=agent-scaffold4py-acp

MQ_BACKEND=rabbitmq
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876

LLM_PROVIDER=echo
LLM_MODEL=echo
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.7
LLM_TOP_P=1.0
LLM_TOP_K=0
LLM_MAX_TOKENS=1024
LLM_ENABLE_THINKING=false
LLM_SHOW_REASONING=false

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=384

VECTORSTORE_BACKEND=memory
VECTORSTORE_ENDPOINT=http://127.0.0.1:8000
VECTORSTORE_COLLECTION=default

CACHE_BACKEND=memory
CACHE_REDIS_URL=redis://127.0.0.1:6379/0

RAG_BACKEND=stub
RAG_ENDPOINT=http://127.0.0.1:9000

DB_URL=sqlite+aiosqlite:///./agent_scaffold.db
DB_ECHO=false
